{
  "name": "avani-calibration-engine",
  "version": "0.5.0",
  "private": true,
  "description": "Transforms application specs into calibrated Claude Code configurations: plugin selection + project-specific artifacts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "calibrate": "tsx engine/bin/calibrate.ts",
    "new": "tsx engine/bin/calibrate.ts new",
    "schema:build": "tsx engine/bin/schema-build.ts",
    "selection:build": "tsx engine/bin/selection-build.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

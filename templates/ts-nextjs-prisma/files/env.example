# Copied to .env automatically by `npm run dev` (db/ensure-env.ts) if .env is missing.
DATABASE_URL="postgresql://postgres:postgres@localhost:{{DB_PORT}}/app_dev?schema=public"

# Stage: dev | staging | production. Defaults to dev; CI/deploy set it per environment.
AVANI_STAGE="dev"

# Live walkthrough: `npm run walkthrough` sets this for you. To show the guide
# panel on a deployed staging app, set WALKTHROUGH="on" there (refused in production).
# WALKTHROUGH="on"

# Clerk (pre-wired behind src/lib/auth.ts). Auth stays DISABLED until these are
# set — the app runs and CI passes without them. Get keys at dashboard.clerk.com.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

{
  "name": "{{APP_NAME}}",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run db:ready && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:ready": "tsx db/ensure-env.ts && docker compose up -d db --wait && prisma migrate deploy && tsx db/init.ts && tsx db/seed.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "tsx db/assert-dev.ts && prisma migrate reset --force && npm run db:seed",
    "db:seed": "tsx db/seed.ts",
    "db:seed:demo": "tsx db/seed-demo.ts",
    "db:init": "tsx db/init.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@hookform/resolvers": "^5.0.0",
    "@prisma/client": "^6.5.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@playwright/test": "^1.50.0",
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "postcss": "^8.4.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
